// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int   @id @default(autoincrement())
  firstName String 
  lastName  String  
  email     String   @unique
  password  String
  bio       String?
  profilePicture     String?
  orientation orientation
  gender   gender
  birthDate DateTime @db.Date 
  countryId  Int
  country    Country @relation(fields: [countryId], references: [id])

  likesFrom  Like[]    @relation("LikesFrom")
  likesTo    Like[]    @relation("LikesTo")

  matches1   Match[]   @relation("Matches1")
  matches2   Match[]   @relation("Matches2")
  
  messages   Message[] 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Country {
  id       Int   @id @default(autoincrement())
  name      String
  iso2Code   String
  flag     String
  user    User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Like {
  id          Int      @id @default(autoincrement())
  fromUserId  Int
  toUserId    Int
  isLike      Boolean
  createdAt   DateTime @default(now())

  fromUser    User     @relation("LikesFrom", fields: [fromUserId], references: [id])
  toUser      User     @relation("LikesTo", fields: [toUserId], references: [id])

  @@unique([fromUserId, toUserId]) // This is to avoid duplicate likes 
}

model Match {
  id         Int      @id @default(autoincrement())
  user1Id    Int
  user2Id    Int
  createdAt  DateTime @default(now())

  user1      User     @relation("Matches1", fields: [user1Id], references: [id])
  user2      User     @relation("Matches2", fields: [user2Id], references: [id])

  message   Message[]

  @@unique([user1Id, user2Id]) // This is to avoid duplicate matches
}

model Message {
  id         Int      @id @default(autoincrement())
  matchId    Int
  senderId   Int
  content    String
  createdAt  DateTime @default(now())

  match      Match    @relation(fields: [matchId], references: [id])
  sender     User     @relation(fields: [senderId], references: [id])
}

enum orientation {
  heterosexual
  homosexual
  bisexual
}

enum gender {
  female
  male
}

